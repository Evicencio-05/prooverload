# Public Instant app id. Required at `npm run build` (inlined into the client)
# and read by /api/auth on the server.
VITE_INSTANT_APP_ID=

# Server-only Instant admin token for Vite middleware and Vercel /api/auth.
# Never prefix this with VITE_.
INSTANT_ADMIN_TOKEN=

# Optional non-VITE alias of the app id for serverless. Skip if VITE_INSTANT_APP_ID is set.
# INSTANT_APP_ID=
